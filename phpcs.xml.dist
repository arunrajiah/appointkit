<?xml version="1.0"?>
<ruleset name="AppointKit">
    <description>AppointKit coding standards.</description>

    <file>.</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>

    <rule ref="WordPress-Extra">
        <!-- Direct DB queries are intentional for custom tables; documented in docs/plugin-check-warnings.md -->
        <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
        <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
    </rule>

    <rule ref="WordPress-Docs"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="appointkit"/>
            </property>
        </properties>
    </rule>

    <config name="minimum_supported_wp_version" value="6.2"/>

    <!--
      PHP cross-version compatibility is NOT checked here.
      PHPCompatibility 9.3.5 (the newest release compatible with PHPCS 3.x / WPCS 3.x)
      crashes on PHP 8.4+ and aborts file checking, which silently hides all other
      violations. Use the official Plugin Check plugin for PHP compatibility instead:
      https://wordpress.org/plugins/plugin-check/
    -->
</ruleset>
